PORT=5002
CLIENT_ORIGIN=http://localhost:5173
# Keep strict for localhost or same-site custom domains. Use none only for
# separate HTTPS sites; production cookies are always Secure.
COOKIE_SAME_SITE=strict
JSON_BODY_LIMIT=2mb
MONGODB_URI=mongodb://127.0.0.1:27017/chat_app
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
